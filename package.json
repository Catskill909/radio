{
  "name": "radio-suite",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npx tsx server.ts\" \"npx tsx recorder-service.ts\"",
    "dev:next": "next dev",
    "recorder": "npx tsx recorder-service.ts",
    "build": "prisma generate && next build",
    "start": "NODE_ENV=production npx tsx server.ts",
    "lint": "eslint",
    "db:backup": "cp prisma/dev.db prisma/dev.db.backup_$(date +%Y%m%d_%H%M%S) && echo 'Backup created in prisma/'",
    "db:studio": "npx prisma studio",
    "db:migrate": "npx prisma migrate dev",
    "db:reset": "npx prisma migrate reset",
    "extend-shows": "npx tsx extend-recurring-shows.ts"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.9",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tiptap/extension-image": "^3.13.0",
    "@tiptap/extension-link": "^3.13.0",
    "@tiptap/pm": "^3.13.0",
    "@tiptap/react": "^3.13.0",
    "@tiptap/starter-kit": "^3.13.0",
    "@types/archiver": "^7.0.0",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/react-big-calendar": "^1.16.3",
    "@types/react-datepicker": "^6.2.0",
    "@types/rss": "^0.0.32",
    "archiver": "^7.0.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "jszip": "^3.10.1",
    "lucide-react": "^0.554.0",
    "next": "^16.0.7",
    "react": "^19.2.1",
    "react-big-calendar": "^1.19.4",
    "react-datepicker": "^8.9.0",
    "react-dom": "^19.2.1",
    "react-dropzone": "^14.3.8",
    "react-h5-audio-player": "^3.10.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "rss": "^1.2.2",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^3.4.0",
    "wavesurfer.js": "^7.11.1"
  },
  "devDependencies": {
    "@prisma/client": "^5.22.0",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.0.3",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
