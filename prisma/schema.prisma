generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Show {
  id               String         @id @default(uuid())
  title            String
  description      String?
  type             String
  host             String?
  email            String?
  author           String?
  explicit         Boolean        @default(false)
  category         String?
  itunesType       String         @default("episodic")
  tags             String?
  image            String?
  recordingEnabled Boolean        @default(false)
  recordingSource  String?
  language         String         @default("en-us")
  copyright        String?
  link             String?
  feedEpisodeLimit Int?                            // Max episodes in RSS feed (null = unlimited)
  archivingEnabled Boolean        @default(true)   // Keep old episodes (true) or delete them (false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  slots            ScheduleSlot[]
}

model ScheduleSlot {
  id                String      @id @default(uuid())
  showId            String
  startTime         DateTime
  endTime           DateTime
  sourceUrl         String?
  isRecurring       Boolean     @default(false)
  recurringGroupId  String?
  splitGroupId      String?
  splitPosition     String?
  recordingOverride Boolean?    // null=use show default, true=force record, false=skip recording
  recordings        Recording[]
  show              Show        @relation(fields: [showId], references: [id], onDelete: Cascade)
}

model Recording {
  id             String        @id @default(uuid())
  scheduleSlotId String?
  filePath       String
  startTime      DateTime
  endTime        DateTime?
  status         String
  createdAt      DateTime      @default(now())
  duration       Int?
  size           Int?
  
  // Quality/Encoding metadata
  audioCodec      String?       // e.g., "libmp3lame", "aac", "flac"
  audioBitrate    Int?          // kbps
  audioSampleRate Int?          // Hz
  
  episode        Episode?
  scheduleSlot   ScheduleSlot? @relation(fields: [scheduleSlotId], references: [id])
}

model Episode {
  id            String    @id @default(uuid())
  recordingId   String    @unique
  title         String
  description   String?
  publishedAt   DateTime?
  episodeNumber Int?
  seasonNumber  Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  duration      Int?
  host          String?
  imageUrl      String?
  tags          String?
  explicit      Boolean?
  recording     Recording @relation(fields: [recordingId], references: [id])
}

model IcecastStream {
  id           String    @id @default(uuid())
  name         String
  url          String
  isEnabled    Boolean   @default(false)
  status       String    @default("unknown")
  bitrate      Int?
  format       String?
  listeners    Int?
  maxListeners Int?
  genre        String?
  description  String?
  lastChecked  DateTime?
  errorMessage String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model StationSettings {
  id          String   @id @default("station")
  timezone    String   @default("UTC")
  name        String?  @default("My Radio Station")
  description String?
  email       String?
  logoUrl     String?
  streamUrl   String?
  
  // Site Branding (Public Front-End)
  siteLogo        String?  // URL to custom logo image
  siteTitle       String?  // Custom front-end title
  siteTagline     String?  // Custom front-end tagline
  showSiteLogo    Boolean  @default(true)
  showSiteTitle   Boolean  @default(true)
  showSiteTagline Boolean  @default(true)
  
  // Audio Recording Quality Settings
  audioCodec      String  @default("libmp3lame")  // "libmp3lame", "aac", "libopus", "flac"
  audioBitrate    Int     @default(192)           // kbps: 64, 128, 192, 256, 320
  audioSampleRate Int?                            // 22050, 44100, 48000 (null = auto)
  audioVBR        Boolean @default(true)          // true = VBR, false = CBR
  
  // Custom Menu Settings (Public Front-End)
  menuEnabled     Boolean @default(true)          // Master toggle for floating menu visibility
  menuItems       String?                         // JSON array of menu items
  
  // ACRCloud Song Recognition
  acrcloudEnabled       Boolean @default(false)   // Master toggle for song recognition
  acrcloudHost          String?                   // e.g., "identify-us-west-2.acrcloud.com"
  acrcloudAccessKey     String?                   // API access key (env var takes precedence in production)
  acrcloudAccessSecret  String?                   // API access secret (env var takes precedence in production)
  acrcloudMonthlyLimit  Int     @default(500)     // Monthly request limit (default 500 = ~$2.70/month)
  acrcloudRequestCount  Int     @default(0)       // Current month's request count
  acrcloudResetDate     DateTime?                 // Date when counter was last reset (null = never)
  
  // SMTP Configuration (for email alerts)
  smtpHost       String?                          // e.g., "mail.yourdomain.com"
  smtpPort       Int       @default(587)          // Common: 587 (TLS), 465 (SSL), 25 (unencrypted)
  smtpUser       String?                          // SMTP username/email
  smtpPassword   String?                          // Encrypted before storage (AES-256)
  smtpFromName   String?   @default("StationDock Alerts")  // Display name in From header
  smtpUseTls     Boolean   @default(true)         // Use STARTTLS/TLS encryption
  
  // Stream Alert Settings
  alertEmails       String?   // JSON array: ["admin@station.com", "engineer@station.com"]
  alertAllStreams   Boolean   @default(false)     // true = all streams, false = primary only
  alertCooldownMins Int       @default(5)         // Minutes between alerts for same stream
  alertOnRecovery   Boolean   @default(true)      // Send email when stream comes back online
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Episode Play Tracking (Public /listen page only)
model EpisodePlay {
  id          String   @id @default(uuid())
  episodeId   String
  showId      String
  playedAt    DateTime @default(now())
  duration    Int?     // seconds listened (optional, for completion tracking)
  userAgent   String?  // browser info for unique listener estimation
  sessionId   String?  // to group plays by session
  createdAt   DateTime @default(now())
  
  @@index([episodeId])
  @@index([showId])
  @@index([playedAt])
}

// Daily aggregated play statistics
model PlayStats {
  id              String   @id @default(uuid())
  date            DateTime @unique  // Daily aggregation (date only, no time)
  totalPlays      Int      @default(0)
  uniqueListeners Int      @default(0)
  createdAt       DateTime @default(now())
}
